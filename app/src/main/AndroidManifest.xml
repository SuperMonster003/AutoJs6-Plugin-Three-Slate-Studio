<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="org.autojs.permission.PLUGIN" />

    <!--
        Roadmap D9: the plugin reads and writes the paths scripts pass, like 3-Maple Image, so it asks for all files
        access on Android 11+ and for the legacy storage permissions below; READ_MEDIA_* list the media of the home
        screen on Android 13+.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!--
        Long tasks run in a data sync foreground service with a progress notification (roadmap P2.1); the Studio
        recorder records the microphone and the playback capture (roadmap D41, P4.5) in a microphone / media
        projection foreground service and keeps a partial wake lock, so it continues with the screen off. Both
        services are declared below.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The update check and, from 1.1.0, the FFmpeg library download (roadmap D39). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        The host (the script entry of roadmap D19 and its bindings) and MediaInfo, whose viewer the detail page opens by
        Intent when it has one (roadmap D18, appendix D Q52).
    -->
    <queries>
        <package android:name="org.autojs.autojs6" />
        <package android:name="io.github.supermonster003.autojs6.plugin.mediainfo" />
    </queries>

    <application
        android:name=".ThreeSlateStudioApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_icon_studio_application"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_icon_studio_application"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThreeSlateStudio"
        tools:targetApi="33">

        <!--
            The only native library is libandroidx.graphics.path.so of Compose, aligned to 16 KB pages and checked by
            the native alignment gate of the build (roadmap D25, appendix D Q9).
        -->
        <meta-data
            android:name="org.autojs.plugin.contract.NATIVE_PAGE_ALIGNMENT"
            android:value="16384" />

        <meta-data
            android:name="org.autojs.plugin.WAKE_ACTIVITY"
            android:value=".WakeActivity" />

        <meta-data
            android:name="org.autojs.plugin.info.AUTHOR"
            android:value="@string/plugin_author" />

        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.WAKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            The Studio home (roadmap P4.1): rotation and resizing keep the wizard drafts (Compose relayouts), the
            appearance changes recreate it between drafts.
        -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <!--
            The timeline editor (roadmap P4.3): rotation and resizing keep the playback and the open dialogs (Compose
            relayouts); the project and its undo history live in the view model.
        -->
        <activity
            android:name=".ui.timeline.TimelineActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.release.ReleaseHistoryActivity"
            android:exported="false" />

        <!-- Opened on STORAGE_PERMISSION_DENIED (roadmap P2.1, D9). -->
        <activity
            android:name=".ui.storage.StorageAccessActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="" />

        <!--
            Launcher icon modes (roadmap D16, P0.2): exactly one alias is enabled at a time; the settings screen of
            roadmap P4.1 switches them. The adaptive automatic mode is the default.
        -->
        <activity-alias
            android:name=".launcher.AdaptiveLightIconAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_system_light"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_system_light"
            android:targetActivity=".ui.home.HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.AdaptiveDarkIconAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_system"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_system"
            android:targetActivity=".ui.home.HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.AdaptiveAutoIconAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_system_auto"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_system_auto"
            android:targetActivity=".ui.home.HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.TransparentIconAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".ui.home.HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".service.ThreeSlateStudioInfoService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <meta-data
                android:name="requiresHostVersion"
                android:value="@string/plugin_requires_host_version" />
            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="three-slate-studio" />
            </intent-filter>
        </service>

        <service
            android:name=".service.ThreeSlateStudioService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <meta-data
                android:name="requiresHostVersion"
                android:value="@string/plugin_requires_host_version" />
            <intent-filter>
                <action android:name="org.autojs.plugin.MEDIA_STUDIO" />
                <category android:name="media-studio" />
            </intent-filter>
        </service>

        <!--
            Opening and sharing outputs from the Studio screens (roadmap P4.1, P4.2), and generated code too large for
            the AutoJs6 "new script" Intent (roadmap P4.4, cache/create-script/).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <!-- Tasks running longer than 10 s (roadmap P2.1). -->
        <service
            android:name=".service.ProcessingForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            The Studio recorder (roadmap D41, P4.5): microphone, plus media projection for the playback capture
            (API 29+); roadmap P7.1 reuses it for screen recording.
        -->
        <service
            android:name=".record.RecordingService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

    </application>

</manifest>
