<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
            Debug builds only: the empty host of the Compose tests that set their own content, in place of the exported
            androidx.activity.ComponentActivity of ui-test-manifest. Not exported; same theme as that activity.
            zh-CN: 仅 debug 构建: 自行设置内容的 Compose 测试所用的空宿主, 代替 ui-test-manifest 中导出的
            androidx.activity.ComponentActivity. 不导出, 主题与那个 Activity 相同.
        -->
        <activity
            android:name=".ComposeTestActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
